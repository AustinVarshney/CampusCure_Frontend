# CampusCure frontend configuration.
# Copy to .env and fill in. NEVER commit .env.
#
# NOTE: Vite inlines every VITE_* variable into the client bundle at build time.
# Anything here is public — never put a secret or API key in this file.

# Backend API base URL, e.g. http://localhost:5000
VITE_BACKEND_URL=

# ---------------------------------------------------------------------------
# CC-05: error reporting (Sentry)
#
# OPTIONAL. With no DSN, reportError logs to the console and sends nothing.
# The error boundary, the global handlers and the request-id correlation all
# still work - they just have no destination.
#
# A DSN is PUBLIC by design. Every Sentry browser install embeds it in the
# bundle, and it only permits writing events to one project. That is why it
# belongs in a VITE_ variable while the backend's other credentials never can.
#
# Sentry -> Settings -> Projects -> <project> -> Client Keys (DSN).
# Use a SEPARATE project from the backend: mixing browser and server events
# makes "is this our code or their browser?" unanswerable.
VITE_SENTRY_DSN=

# Tag for this deployment. Defaults to Vite's MODE ("development"/"production").
VITE_SENTRY_ENVIRONMENT=
